{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DocumentEditor Desktop",
            "type": "node-terminal",
            "request": "launch",
            "command": "./gradlew :composeApp:run",
            "cwd": "${workspaceFolder}/DocumentEditorDesktop/DocumentEditorDesktop"
        },
        {
            "name": "DocumentEditor Desktop (Java)",
            "type": "java",
            "request": "launch",
            "mainClass": "org.example.documenteditordesktop.MainKt",
            "projectName": "composeApp",
            "cwd": "${workspaceFolder}/DocumentEditorDesktop/DocumentEditorDesktop"
        }
    ]
}
